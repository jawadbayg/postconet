# Copy to apps/desktop/.env for local development.
# These values are application deployment configuration, not end-user login fields.
# Never put a Supabase service-role key in the desktop app.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional hosted worker for monitors, hosted mocks, and inbound webhooks.
# Leave empty to keep those features local-only.
VITE_WORKER_URL=

# Optional public docs/mock hostname advertised in the UI.
VITE_PUBLIC_HOST=

# Worker-only (apps/worker/.env) — never ship these in the desktop binary
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
WORKER_PORT=8787
WORKER_PUBLIC_BASE_URL=http://localhost:8787
MONITOR_SECRET_ENCRYPTION_KEY=
ALLOWED_EGRESS_CIDRS=
MAX_MONITOR_CONCURRENCY=4

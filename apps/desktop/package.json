{
  "name": "@postconet/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "productName": "PostConet API Studio",
  "scripts": {
    "dev": "node scripts/apply-dev-icon.mjs && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "rebuild:native": "node -e \"process.exit(0)\"",
    "pack:mac": "electron-vite build && electron-builder --mac --config electron-builder.yml",
    "pack:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "lint": "echo 'no renderer eslint config yet'"
  },
  "dependencies": {
    "@postconet/core": "workspace:*",
    "@postconet/persistence": "workspace:*",
    "@supabase/supabase-js": "2.117.3",
    "electron-updater": "6.3.9",
    "undici": "7.3.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@monaco-editor/react": "4.6.0",
    "@tailwindcss/forms": "0.5.9",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "electron": "35.1.2",
    "electron-builder": "25.1.8",
    "electron-vite": "3.0.0",
    "lucide-react": "0.469.0",
    "monaco-editor": "0.52.2",
    "postcss": "8.4.49",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-resizable-panels": "2.1.7",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "6.0.11",
    "zustand": "5.0.3"
  }
}

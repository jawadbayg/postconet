{
  "name": "@postconet/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "postconet": "./dist/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsx src/index.ts --help >/dev/null 2>&1 || true; esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@postconet/core": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
